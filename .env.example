# Copy to .env for local `pnpm dev` - vite loads this automatically.

# SvelteKit adapter-node's own origin setting, used for absolute URL generation.
ORIGIN=http://localhost:3000

# Server-only: used by src/lib/server/api.ts for SSR/load-function requests.
API_BASE=http://localhost:8080

# Public: bundled for the browser, used for direct client fetches and <img> src.
PUBLIC_API_BASE=http://localhost:8080
